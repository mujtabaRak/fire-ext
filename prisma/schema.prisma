datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum FireClass {
  A
  B
  C
  K
}

enum ExtinguisherType {
  ABC
  CO2
  HCFC_123
  FOAM
  WET_CHEMICAL
}

model Product {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  sizeKg           Float
  type             ExtinguisherType
  coverageAreaSqFt Int
  fireClasses      String
  price            Float
  useCase          String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

enum PaymentStatus {
  unpaid
  payment_pending
  paid
}

enum PaymentMethod {
  upi_manual
}

model Bill {
  id              String        @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNumber   String        @unique
  customerName    String
  customerPhone   String
  billingAddress  String
  shippingAddress String
  items           String
  taxRate         Float         @default(0)
  discount        Float         @default(0)
  subtotal        Float
  total           Float
  notes           String?
  invoiceDate     DateTime      @default(now())
  dueDate         DateTime?
  paymentStatus   PaymentStatus @default(unpaid)
  paymentMethod   PaymentMethod @default(upi_manual)
  upiUtr          String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
